<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Emby.Xtream.Plugin</AssemblyName>
    <RootNamespace>Emby.Xtream.Plugin</RootNamespace>
    <Version>0.0.0-dev</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MediaBrowser.Common" HintPath="$(MSBuildThisFileDirectory)../lib/MediaBrowser.Common.dll" Private="true" />
    <Reference Include="MediaBrowser.Controller" HintPath="$(MSBuildThisFileDirectory)../lib/MediaBrowser.Controller.dll" Private="true" />
    <Reference Include="MediaBrowser.Model" HintPath="$(MSBuildThisFileDirectory)../lib/MediaBrowser.Model.dll" Private="true" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration\Web\**" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Emby.Xtream.Plugin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
